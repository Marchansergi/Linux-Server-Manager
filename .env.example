# Linux Server Manager configuration. All variables are optional.
# Copy to .env (never commit it) or set them in docker-compose.yml.

# SQLite database for users and sessions.
LSM_DATABASE_URL=sqlite:///./data/lsm.db

# Root of the monitored host's filesystem: "/" on the host, "/host" in Docker.
LSM_HOST_ROOT=/

# Session lifetime in minutes (5 to 43200).
LSM_SESSION_TTL_MINUTES=720

# Send the session cookie only over HTTPS. Browsers also accept it on
# http://localhost. Set to false only for plain-HTTP access on a trusted network.
LSM_COOKIE_SECURE=true

# Failed logins allowed per client IP within the window before returning 429.
LSM_LOGIN_MAX_ATTEMPTS=5
LSM_LOGIN_WINDOW_SECONDS=300

# Directory of the built frontend to serve (set automatically in Docker).
# LSM_FRONTEND_DIST=../frontend/dist

LSM_LOG_LEVEL=INFO
